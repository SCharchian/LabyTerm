# Maintainer: Sam Charchian <147100012+SCharchian@users.noreply.github.com>
#
# One recipe for both homes: the Omarchy package repository (omacom/omarchy-pkgs, with omarchy-package.json
# beside it as .omarchy/package.json) and, once AUR registration reopens, the AUR.
pkgname=labyterm
pkgver=1.1.0
pkgrel=1
pkgdesc='First-person dungeon crawler drawn as colored text cells, themed from your Omarchy theme'
arch=('x86_64')
url='https://github.com/SCharchian/LabyTerm'
license=('MIT' 'CC-BY-4.0')
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'sdl3'
)
makedepends=(
  'cmake'
  'ninja'
  'nlohmann-json'
  'shaderc'
)
optdepends=('vulkan-driver: GPU screen filter (without one the slower CPU filter is used)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9559f8092dc930380bae5cce7d9206aac13f0ecabae1219698cd98a35d1b9324')

build() {
  cmake -S "LabyTerm-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLABYTERM_DEBUG_KEYS=OFF \
    -DLABYTERM_SOURCE_DATA_DIR=/usr/share/labyterm
  cmake --build build --target labyterm
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "LabyTerm-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "LabyTerm-$pkgver/LICENSE-ART.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ART.txt"
}
